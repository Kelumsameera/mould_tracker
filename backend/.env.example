# This app's own database (the part after the host is the database name).
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/mould_tracker?retryWrites=true&w=majority&appName=ToolTracker
# Only for migrations/upgradeMouldModel.mjs: the old database to copy from (read-only).
# SOURCE_MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/OLD_DB?retryWrites=true&w=majority
PORT=4000
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d
# Comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Exact trusted HTTPS origin (no trailing slash). Leave blank to disable passkeys.
WEBAUTHN_ORIGIN=
# Must match the hostname of WEBAUTHN_ORIGIN, without scheme or port.
WEBAUTHN_RP_ID=
