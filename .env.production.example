# Copy to .env in the project root on the Ubuntu server.
# Generate separate passwords with: openssl rand -hex 32
# Keep these values when upgrading: they authenticate the persistent database.
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Set this to the exact URL used in your browser.
APP_ORIGIN=http://192.168.0.116:8081
HTTP_PORT=8081
# Set true when accessing through HTTPS.
COOKIE_SECURE=false
# Passkeys require trusted HTTPS. Example: https://tools.example.com
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_ID=
